{
  // link/ mirrors $HOME, so VS Code recognizes files such as .zshrc,
  // .zprofile, and .gitconfig automatically. List only exceptions here.
  "files.associations": {
    // link/: files with neither a recognized extension nor a known filename
    "**/link/.gemrc": "yaml",
    "**/link/.config/bat/config": "properties",
    "**/link/.config/git/ignore": "ignore",

    // home/: chezmoi source files not identified by the dot_ prefix or .tmpl suffix
    "*.sh.tmpl": "shellscript",
    // modify_ filenames may contain .json, but their contents are shell scripts
    "modify_*": "shellscript",
    "*.toml.tmpl": "toml",
    ".chezmoiignore": "ignore",
    "dot_zprofile.local.tmpl": "shellscript",
    "dot_gitconfig.local.tmpl": "properties"
  }
}
