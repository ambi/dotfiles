{
  // chezmoi のソース (home/) は dot_ 接頭辞と .tmpl 接尾辞が付き、
  // symlink の実体 (link/) は拡張子が無いため、どちらも VS Code が
  // 言語を判定できない。判定できないものだけをここで対応付ける。
  "files.associations": {
    // link/ … symlink の実体。手編集するとリポジトリに直接反映される
    "zshrc": "shellscript",
    "zprofile": "shellscript",
    "gitconfig": "properties",
    "gemrc": "yaml",
    "**/link/config/bat/config": "properties",
    "**/link/config/ghostty/config": "ini",
    "**/link/config/git/ignore": "ignore",

    // home/ … chezmoi が配置するもの
    "*.sh.tmpl": "shellscript",
    // modify_ は名前に .json が入るが中身はシェルスクリプト
    "modify_*": "shellscript",
    "*.toml.tmpl": "toml",
    ".chezmoiignore": "ignore",
    "dot_zprofile.local.tmpl": "shellscript",
    "dot_gitconfig.local.tmpl": "properties"
  }
}
