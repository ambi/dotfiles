#!/bin/sh
# Sync external Agent Skills into ~/.agents/skills.
#
# The skills CLI lock file tracks installed contents and their sources. Chezmoi
# records only the desired skill names and reruns this script when the list
# changes. Locally authored skills are managed as regular files by chezmoi and
# are not touched here.
set -eu

export PATH="$HOME/.local/bin:$PATH"
echo "==> Syncing mattpocock/skills"
mise exec -- skills add mattpocock/skills \
    --skill \
    ask-matt \
    code-review \
    codebase-design \
    diagnosing-bugs \
    domain-modeling \
    grill-me \
    grill-with-docs \
    grilling \
    handoff \
    implement \
    improve-codebase-architecture \
    prototype \
    research \
    resolving-merge-conflicts \
    setup-matt-pocock-skills \
    tdd \
    teach \
    to-questionnaire \
    to-spec \
    to-tickets \
    triage \
    wait-what \
    wayfinder \
    wizard \
    writing-for-agents \
    --global \
    --agent claude-code \
    --yes

echo "==> Syncing yusukebe/ax"
mise exec -- skills add yusukebe/ax \
    --skill ax \
    --global \
    --agent claude-code \
    --yes
