#!/bin/sh
# Run once during the first apply on a new machine (run_once_).
# Run before applying files so Homebrew and Brewfile packages are ready first.
set -eu
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$({{ .brewPrefix }}/bin/brew shellenv)"
echo "==> brew bundle"
brew bundle --file="{{ .chezmoi.workingTree }}/Brewfile"
{{- else -}}
echo "==> Skipping Brewfile on {{ .chezmoi.os }}"
{{- end }}
