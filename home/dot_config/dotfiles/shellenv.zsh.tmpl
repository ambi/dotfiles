# Generated by chezmoi; edit template data rather than this deployed file.
if [[ -x {{ (joinPath .brewPrefix "bin/brew") | quote }} ]]; then
  eval "$({{ (joinPath .brewPrefix "bin/brew") | quote }} shellenv)"
else
  # mise's cask manager links application CLIs into this prefix without brew.
  export HOMEBREW_PREFIX={{ .brewPrefix | quote }}
  typeset -U path PATH
  path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
fi

{{ if .proxy -}}
export http_proxy={{ .proxy | quote }}
export https_proxy={{ .proxy | quote }}
export no_proxy="localhost,127.0.0.1,::1"
{{ end -}}
