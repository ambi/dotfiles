{{- /* Machine-specific, non-secret values collected through prompts and template variables. */ -}}
{{- $name  := promptStringOnce . "name"  "Git name"  "tn" -}}
{{- $email := promptStringOnce . "email" "Git email" "prtnog@gmail.com" -}}
{{- $proxy := promptStringOnce . "proxy" "HTTP proxy (leave blank for none)" "" -}}
{{- $installPersonalPackages := promptBoolOnce . "installPersonalPackages" "Install personal Homebrew packages" false -}}

{{- /* Keep the OS- and architecture-specific Homebrew prefix in one place. */ -}}
{{- $brewPrefix := "/opt/homebrew" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- else if and (eq .chezmoi.os "darwin") (ne .chezmoi.arch "arm64") -}}
{{-   $brewPrefix = "/usr/local" -}}
{{- end -}}

{{- /* Use this repository as the source; .chezmoiroot descends into home/. */}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    name       = {{ $name  | quote }}
    email      = {{ $email | quote }}
    proxy      = {{ $proxy | quote }}
    brewPrefix = {{ $brewPrefix | quote }}
    installPersonalPackages = {{ $installPersonalPackages }}
