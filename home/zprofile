## brew
# prefix は OS/arch で変わる。テンプレートにすると symlink にできず、
# インストーラの追記がリポジトリに書き戻らなくなるため実行時に探索する。
for __brew in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [ -x "$__brew/bin/brew" ]; then
    eval "$("$__brew/bin/brew" shellenv)"
    break
  fi
done
unset __brew

## local
export PATH=~/.local/bin:$PATH

## machine-specific (proxy 等) — chezmoi が生成する
[ -f ~/.zprofile.local ] && source ~/.zprofile.local
