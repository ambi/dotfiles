{{- /*
   外部リポジトリから取得する skill。自作分（ast-grep / ast-grep-outline /
   commit / japanese-tech-writing）は link/.agents/skills/ に実体があるので
   ここには載せない。

   1 skill = 1 external にしている。.agents/skills ディレクトリ全体を単一の
   external にすると自作分と同居できないため。同じ URL のアーカイブは
   chezmoi がキャッシュするので、件数ぶんダウンロードが走ることはない。

   include / exclude は stripComponents 適用「前」のパスにマッチするので、
   先頭の <repo>-main/ を * で受ける必要がある。

   更新は refreshPeriod 経過後の apply か `chezmoi -R apply`。
*/ -}}

{{- /*
   mattpocock/skills
   アーカイブ内は <repo>-main/skills/<category>/<name>/ なので strip は 4。
   カテゴリを * で受けているのは、upstream が skill を別カテゴリへ移したときに
   include がマッチしなくなって黙って空になるのを避けるため。
*/ -}}
{{- $mattpocock := list
      "ask-matt" "code-review" "codebase-design"
      "diagnosing-bugs" "domain-modeling" "grill-me"
      "grill-with-docs" "grilling" "handoff"
      "implement" "improve-codebase-architecture" "prototype"
      "research" "resolving-merge-conflicts" "setup-matt-pocock-skills"
      "tdd" "teach" "to-questionnaire"
      "to-spec" "to-tickets" "triage"
      "wait-what" "wayfinder" "wizard"
      "writing-for-agents" -}}
{{ range $name := $mattpocock }}
[".agents/skills/{{ $name }}"]
    type           = "archive"
    url            = "https://github.com/mattpocock/skills/archive/refs/heads/main.tar.gz"
    stripComponents = 4
    include        = ["*/skills/*/{{ $name }}", "*/skills/*/{{ $name }}/**"]
    refreshPeriod  = "168h"
{{ end }}
{{- /*
   yusukebe/ax
   こちらは <repo>-main/skills/<name>/ とカテゴリ階層が無いので strip は 3。
*/ -}}
[".agents/skills/ax"]
    type           = "archive"
    url            = "https://github.com/yusukebe/ax/archive/refs/heads/main.tar.gz"
    stripComponents = 3
    include        = ["*/skills/ax", "*/skills/ax/**"]
    refreshPeriod  = "168h"
