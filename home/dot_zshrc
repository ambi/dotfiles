# A directly started non-login shell might not have read .zprofile.
if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
  [[ -r "$HOME/.config/dotfiles/shellenv.zsh" ]] && source "$HOME/.config/dotfiles/shellenv.zsh"
fi

## mise
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

## Alias
alias ll="ls -GFlah"
alias ls="ls -GF"
alias rg="rg -M 1000 --max-columns-preview"

if (( $+commands[eza] )); then
  lt() {
    command eza --tree --level=2 --group-directories-first "$@"
  }
fi

## Interactive behavior
setopt interactive_comments

## Changing Directories
setopt auto_pushd
setopt pushd_ignore_dups

## Completion
typeset -U fpath
fpath=(
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/zsh-completions}
  "$HOME/.docker/completions"
  "$HOME/.zfunc"
  $fpath
)
autoload -Uz compinit compaudit
zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
zcompaudit_stamp="${zcompdump:h}/zcompaudit.stamp"
mkdir -p "${zcompdump:h}"
# Recheck completion ownership daily; use the dump without another audit until
# then. Homebrew intentionally makes its share directory group-writable on
# macOS, so trust that exact directory only when it is owned by this user.
old_zcompaudit_stamp=("$zcompaudit_stamp"(N.mh+24))
if [[ ! -e "$zcompdump" || ! -e "$zcompaudit_stamp" ]] || (( ${#old_zcompaudit_stamp} )); then
  insecure_dirs=(${(f)"$(compaudit 2>/dev/null)"})
  unexpected_insecure_dirs=()
  for insecure_dir in "${insecure_dirs[@]}"; do
    if [[ -n ${HOMEBREW_PREFIX:-} &&
          "$insecure_dir" == "$HOMEBREW_PREFIX/share" &&
          -O "$insecure_dir" && ! -L "$insecure_dir" ]]; then
      continue
    fi
    unexpected_insecure_dirs+=("$insecure_dir")
  done

  if (( ${#unexpected_insecure_dirs} )); then
    print -u2 -r -- "Ignoring insecure completion directories:"
    print -u2 -r -l -- "${unexpected_insecure_dirs[@]}"
    compinit -i -d "$zcompdump" && command touch "$zcompaudit_stamp"
  else
    compinit -u -d "$zcompdump" && command touch "$zcompaudit_stamp"
  fi
else
  compinit -C -d "$zcompdump"
fi
unset zcompdump zcompaudit_stamp old_zcompaudit_stamp
unset insecure_dirs unexpected_insecure_dirs insecure_dir

if (( $+commands[uv] )); then
  eval "$(uv generate-shell-completion zsh)"
fi
if (( $+commands[uvx] )); then
  eval "$(uvx --generate-shell-completion zsh)"
fi
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

if [[ -n ${HOMEBREW_PREFIX:-} && -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

## Expansion and Globbing
# Filename expansion after "="
setopt magic_equal_subst

## History
HISTSIZE=200000
SAVEHIST=100000
HISTFILE="$HOME/.zsh_history"

setopt hist_expire_dups_first
setopt hist_find_no_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt share_history

autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^P" history-beginning-search-backward-end
bindkey "^N" history-beginning-search-forward-end

## Prompt
autoload -Uz vcs_info
setopt prompt_subst
zstyle ':vcs_info:git:*' check-for-staged-changes true
zstyle ':vcs_info:git:*' stagedstr "%F{yellow}!"
zstyle ':vcs_info:*' formats "%F{green}%c[%b]%f"
zstyle ':vcs_info:*' actionformats '[%b|%a]'
autoload -Uz add-zsh-hook
add-zsh-hook precmd vcs_info
PROMPT='%B%/%b ${vcs_info_msg_0_}
%B%#%b '

## zoxide
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

## Machine-specific settings, intentionally unmanaged by chezmoi
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

## zsh-syntax-highlighting (MUST be last)
if [[ -n ${HOMEBREW_PREFIX:-} && -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
